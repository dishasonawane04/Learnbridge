# ===============================
# Python bytecode
# ===============================
__pycache__/
*.pyc
*.pyo
*.pyd

# ===============================
# Django
# ===============================
db.sqlite3
*.sqlite3
staticfiles/
media/

# ===============================
# Environment variables
# ===============================
.env
*.env
**/.env

# ===============================
# Logs & temp files
# ===============================
*.log
check_log.txt
check_results.txt
error_output.txt
migration_error.txt

# ===============================
# Virtual environments
# ===============================
env/
venv/
.venv/
*/venv/

# ===============================
# IDEs & Editors
# ===============================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ===============================
# OS files
# ===============================
.DS_Store
Thumbs.db

# ===============================
# Backup / generated data files
# ===============================
sqlite_backup.json
clean_backup.json
full_data.json

# ===============================
# Allow important files explicitly
# ===============================
!requirements.txt
!README.md
!IMPLEMENTATION_SUMMARY.md
!QUICKSTART.md
!VERIFICATION_CHECKLIST.md

# ===============================
# Allow Node manifests if present
# ===============================
!package.json
!package-lock.json

# ===============================
# Allow config JSONs (important)
# ===============================
!suite/field_config/*.json
!docs/*.json
