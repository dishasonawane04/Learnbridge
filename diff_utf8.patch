+        // --- Dynamic Navbar & Course State ---
+        window.activeCourseId = "{{ active_course.id|default:'' }}";
+
+        async function refreshNavbarCourses() {
+            try {
+                const response = await fetch('/course/api/user/courses/', {
+                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
+                });
+                const data = await response.json();
+                const container = document.getElementById('nav-course-list');
+                if (!container) return;
+
+                if (data.courses && data.courses.length > 0) {
+                    container.innerHTML = data.courses.map(c => `
+                        <form action="/core/set-active-course/" method="post" style="margin: 0;">
+                            <input type="hidden" name="csrfmiddlewaretoken" value="${getCookie('csrftoken')}">
+                            <input type="hidden" name="course_id" value="${c.id}">
+                            <button type="submit"
+                                class="dropdown-item ${window.activeCourseId == c.id ? 'active-item' : ''}"
+                                style="width: 100%; border: none; background: none; text-align: left; cursor: pointer; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
+                                <span style="color: white; font-weight: 500;">${c.title}</span>
+                                <span style="font-size: 0.75rem; opacity: 0.6;">${c.level}</span>
+                            </button>
+                        </form>
+                    `).join('');
+                } else {
+                    container.innerHTML = '<div style="padding: 1rem; color: var(--text-muted); font-size: 0.85rem; text-align: center;">No courses available</div>';
+                }
+
+                // Also update the active course display name in the trigger button
+                const triggerText = document.querySelector('.nav-dropdown .nav-link').childNodes[2];
+                const activeCourse = data.courses ? data.courses.find(c => c.id == window.activeCourseId) : null;
+                if (triggerText) {
+                    triggerText.textContent = activeCourse ? ` ${activeCourse.title.substring(0, 15)}${activeCourse.title.length > 15 ? '...' : ''} ` : ' Select Course ';
+                }
+
+                // If active course was deleted, refresh page to clear context
+                const activeStillExists = data.courses ? data.courses.some(c => c.id == window.activeCourseId) : false;
+                if (window.activeCourseId && !activeStillExists) {
+                    window.location.reload();
+                }
+            } catch (err) {
+                console.error('Navbar refresh failed:', err);
+            }
+        }
+
+        function getCookie(name) {
+            let cookieValue = null;
+            if (document.cookie && document.cookie !== '') {
+                const cookies = document.cookie.split(';');
+                for (let i = 0; i < cookies.length; i++) {
+                    const cookie = cookies[i].trim();
+                    if (cookie.substring(0, name.length + 1) === (name + '=')) {
+                        cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
+                        break;
+                    }
+                }
+            }
+            return cookieValue;
+        }
+
+        // Global Delete Handler for AJAX support
+        window.handleCourseDeletion = async function (courseId, title) {
+            if (!confirm(`Are you sure you want to delete "${title}"?`)) return;
+
+            try {
+                const response = await fetch(`/course/${courseId}/delete/?format=json`, {
+                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
+                });
+                const result = await response.json();
+                if (result.status === 'success') {
+                    // Update UI components
+                    refreshNavbarCourses();
+                    if (typeof loadQuickHub === 'function') loadQuickHub();
+
+                    // If on course list page, remove the card
+                    const card = document.querySelector(`.course-card-premium[data-id="${courseId}"]`);
+                    if (card) {
+                        card.style.opacity = '0';
+                        setTimeout(() => card.remove(), 300);
+                    }
+                }
+            } catch (err) {
+                console.error('Deletion failed:', err);
+            }
+        };
     </script>
